if (RequestKey của owner đã cam kết?) then (có)
 if (Fingerprint giống?) then (có)
  :Trả đúng đơn cũ, không giữ thêm;
 else (không)
  :Trả xung đột khóa; không sửa đơn cũ;
 endif
 :Kết thúc giao dịch đọc, nhả khóa;
 stop
endif
:Đọc lại giỏ/giá/ưu đãi từ backend;
if (Giỏ, version, báo giá và ưu đãi hợp lệ?) then (không)
 :ROLLBACK; yêu cầu xác nhận giá/sửa giỏ;
 stop
endif
:Gộp SKU mua lẻ + bộ + món kèm;\nkhóa/so phiên bản tài nguyên theo thứ tự D03;
